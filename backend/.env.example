DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave blank locally. Set to the HTTPS public API address in production.
CMS_PUBLIC_API_BASE_URL=
POSTGRES_PASSWORD=
# Set the same generated password here (URL-encode reserved characters).
DATABASE_URL=postgresql://iod_gh:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:55432/iod_gh
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
EXAM_PORTAL_URL=http://localhost:3001
# Reuses the existing institutional email system; enable after SMTP is verified.
EXAM_EMAIL_NOTIFICATIONS=false
# Resend SMTP: add values from the Resend dashboard. Never commit backend/.env.
DEFAULT_FROM_EMAIL=hello@aduseimedia.codes
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
# Resend requires this exact SMTP username.
EMAIL_HOST_USER=hello@aduseimedia.codes
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
# Create a Resend API key and keep it only in backend/.env.
EMAIL_HOST_PASSWORD=
DJANGO_ENABLE_ADMIN=true
LOG_LEVEL=INFO
PGADMIN_DEFAULT_EMAIL=hello@aduseimedia.codes
PGADMIN_DEFAULT_PASSWORD=
# Leave empty for direct connections. Only list actual trusted proxy IPs/CIDRs.
TRUSTED_PROXY_CIDRS=
# Set true only when the API is reachable solely through a trusted TLS proxy.
DJANGO_TRUST_PROXY_SSL_HEADER=false
# Required in production; ClamAV must only be reachable over a private network.
CLAMAV_HOST=
CLAMAV_PORT=3310
